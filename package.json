{
  "name": "konpoh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "こつこつ梱包室：販売前チェックと梱包（端末内処理）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs && node e2e/trial.mjs",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/build-artifact.mjs",
    "e2e:trial": "node e2e/trial.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}